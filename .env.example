# --- Database ---
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/bci_synergy_pos"

# --- App ---
APP_URL="http://localhost:3000"
BRAND_NAME="BCI Synergy POS"
# Script/automation key for /api/admin/* (min 24 chars). Console uses user logins.
ADMIN_API_KEY="change-me"
# Monthly Elite close cron (min 24 chars; Vercel sends it as Bearer)
CRON_SECRET=""
# Merchant.id of the house account that collects Elite dues balances
PLATFORM_MERCHANT_ID=""
# First platform admin created by `npm run db:seed`
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD=""

# --- Payments provider: mock | tilled | finix ---
PAYMENTS_PROVIDER="mock"

# Tilled (sandbox: https://sandbox-api.tilled.com)
TILLED_API_BASE="https://sandbox-api.tilled.com"
TILLED_SECRET_KEY=""
TILLED_PARTNER_ACCOUNT_ID=""
TILLED_WEBHOOK_SECRET=""

# Finix (sandbox: https://finix.sandbox-payments-api.com)
FINIX_API_BASE="https://finix.sandbox-payments-api.com"
FINIX_USERNAME=""
FINIX_PASSWORD=""
FINIX_APPLICATION_ID=""
FINIX_WEBHOOK_SECRET=""

# --- Economics (basis points) ---
# Platform margin charged above provider cost
PLATFORM_MARGIN_BPS=75
# Instant payout fee charged to merchant
INSTANT_PAYOUT_FEE_BPS=100
# Elite membership dues, cents per month
ELITE_DUES_CENTS_MONTHLY=50000
